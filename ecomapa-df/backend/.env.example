NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://ecomapa:ecomapa_dev@localhost:5432/ecomapa?schema=public"
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# false = pontos de demonstração nunca aparecem na API pública
INCLUDE_DEMO=false
LOG_LEVEL=info
# Rotas: servidor OSRM público (uso razoável, máx. 1 req/s). Para produção, hospede o seu.
OSRM_BASE_URL=https://routing.openstreetmap.de
# Identifique o app com um contato real, ex.: EcoMapaDF/0.3 (contato: voce@dominio.com)
HTTP_USER_AGENT=EcoMapaDF/0.3
# Usado apenas pelo script geocode:regions (política do Nominatim exige contato)
NOMINATIM_CONTACT=
