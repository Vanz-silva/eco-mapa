{
  "name": "ecomapa-df-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:postgis": "prisma db execute --file prisma/postgis.sql --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "import:csv": "node scripts/import-csv.js",
    "geocode:regions": "node scripts/geocode-regions.js",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:postgis && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "~6.2.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "~6.2.1"
  }
}
